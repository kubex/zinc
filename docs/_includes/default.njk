<!DOCTYPE html>
<html
  class="zn-cloak"
  lang="en"
  data-layout="{{ layout }}"
  data-zinc-version="{{ meta.version }}"
  data-build-id="{{ buildId }}">
<head>
  {# Metadata #}
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="description" content="{{ meta.description }}"/>
  <title>{{ meta.title }}</title>

  {# Opt out of Turbo caching #}
  <meta name="turbo-cache-control">

  {# Twitter Cards #}
  <meta name="twitter:card" content="summary"/>
  <meta name="twitter:creator" content="kubex"/>
  <meta name="twitter:image" content="{{ assetUrl(meta.image, true) }}"/>

  {# OpenGraph #}
  <meta property="og:url" content="{{ rootUrl(page.url, true) }}"/>
  <meta property="og:title" content="{{ meta.title }}"/>
  <meta property="og:description" content="{{ meta.description }}"/>
  <meta property="og:image" content="{{ assetUrl(meta.image, true) }}"/>

  {# Stylesheets #}
  <link rel="stylesheet" href="{{ assetUrl('styles/docs.css') }}"/>
  <link rel="stylesheet" href="{{ assetUrl('styles/code-previews.css') }}"/>
  <link rel="stylesheet" href="{{ assetUrl('styles/search.css') }}"/>

  {# Zinc #}
  <script type="module" src="/dist/zn.min.js"></script>
  <link rel="stylesheet" href="/dist/zn.min.css"/>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@700&display=swap">

  {# Scripts #}
  <script src="{{ assetUrl('scripts/turbo.js') }}" type="module"></script>
  <script src="{{ assetUrl('scripts/docs.js') }}" defer></script>
  <script src="{{ assetUrl('scripts/code-previews.js') }}" defer></script>
  <script src="{{ assetUrl('scripts/lunr.js') }}" defer></script>
  <script src="{{ assetUrl('scripts/search.js') }}" defer></script>
</head>
<body>
<a id="skip-to-main" class="visually-hidden" href="#main-content" data-smooth-link="false">
  Skip to main content
</a>

<header id="topbar">
  <button id="menu-toggle" type="button" aria-label="Menu">
    <svg width="148" height="148" viewBox="0 0 148 148" xmlns="http://www.w3.org/2000/svg">
      <g stroke="currentColor" stroke-width="18" fill="none" fill-rule="evenodd" stroke-linecap="round">
        <path d="M9.5 125.5h129M9.5 74.5h129M9.5 23.5h129"></path>
      </g>
    </svg>
  </button>

  <a class="topbar__logo" href="/">
    <img src="{{ assetUrl('images/watermark.svg') }}" alt="zinc"/>
  </a>
  <zn-badge class="sidebar-version">{{ meta.version }}</zn-badge>

  <button class="search-box" type="button" title="Press / to search" data-plugin="search">
    <zn-icon src="search" library="lucide" size="16"></zn-icon>
    <span>Search</span>
    <kbd>/</kbd>
  </button>

  <div id="icon-toolbar">
    <a href="https://github.com/kubex/zinc" title="View zinc on GitHub" aria-label="View zinc on GitHub">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/>
      </svg>
    </a>

    <zn-dropdown id="theme-selector" placement="bottom-end" distance="3">
      <zn-button slot="trigger" color="transparent" title="Press \ to toggle">
        <zn-icon class="only-light" src="sun" library="lucide" size="18"></zn-icon>
        <zn-icon class="only-dark" src="moon" library="lucide" size="18"></zn-icon>
      </zn-button>
      <zn-menu>
        <zn-menu-item type="checkbox" value="light">Light</zn-menu-item>
        <zn-menu-item type="checkbox" value="dark">Dark</zn-menu-item>
        <zn-menu-item type="checkbox" value="auto">System</zn-menu-item>
        <hr style="margin: 0; border: none; border-top: 1px solid rgba(0,0,0,0.1);">
        <zn-menu-item type="checkbox" value="density:compact">Compact</zn-menu-item>
        <zn-menu-item type="checkbox" value="density:comfortable">Comfortable</zn-menu-item>
      </zn-menu>
    </zn-dropdown>
  </div>
</header>

{# Content #}
<aside id="sidebar" data-preserve-scroll>
  <nav>
    {% include 'sidebar.njk' %}
  </nav>
</aside>

{# Content #}
<main>
  <a id="main-content"></a>
  <article id="content"
           class="content{% if toc %} content--with-toc{% endif %}{% if fullWidth %} content--full-width{% endif %}">
    {% if toc %}
      <div class="content__toc">
        <ul>
          <li class="top"><a href="#">{{ meta.title }}</a></li>
        </ul>
      </div>
    {% endif %}

    <div class="content__body">
      {% block content %}
        {{ content | safe }}
      {% endblock %}
    </div>
  </article>
</main>
</body>
</html>
